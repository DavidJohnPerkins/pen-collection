<%- include('../includes/head.ejs') %>
	<link rel="stylesheet" href="/css/main.css">
	<link rel="stylesheet" href="/css/collection-item.css">
	</head>

	<body>
		<%- include('../includes/navigation.ejs') %>
		<main class="centered">
			<h1><%= item.BRAND %> - <%= item.RANGE %>: <%= item.INK_NAME %></h1>
			<hr>
			<div class="parent">
				<div class="child child__map">
					<div class="pen__image">
						<img src="/images/ink-image/<%= item.IMAGE_1 %>" alt="<%= item.INK_NAME %>">
					</div>
				</div>
			</div>
			<h2><%= item.CONTAINER %> (<%= item.CONTAINER_SIZE %>)</h2>
		</main>
		<%- include('../includes/end.ejs') %>