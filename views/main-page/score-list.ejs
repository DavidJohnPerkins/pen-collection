<%- include('../includes/head.ejs') %>
	<link rel="stylesheet" href="/css/collection-item.css">
	</head>

	<body>
		<%- include('../includes/navigation.ejs') %>

			<main>
				<% if (items.length > 0) { %>
					<div class="grid">
						<% for (let item of items) { %>
							<article class="card map-item">
								<header class="map__header">
									<h1 class="map__title">
										<%= item.COMPOSER %>
									</h1>
									<h2 class="map__title">
										<%= item.WORK_NAME %>
									</h2>
									<h2 class="map__title">
										<%= item.key_value %>
									</h2>
								</header>
								<div class="card__actions">
									<a href="/scoreItem/<%= item.item_id %>" class="btn">Details</a>
								</div>								<header class="map__header">
							</article>
						<% } %>
					</div>
					<% } else { %>
						<h1>No scores found</h1>
						<% } %>
			</main>
			<%- include('../includes/end.ejs') %>
